# Port configuration
PORT=8000

# Google Service Account Credentials
# Create a Service Account in the Google Cloud Console, enable the Google Drive API,
# and paste its client email and private key (ensure newlines are preserved or written as \n)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC7...\n-----END PRIVATE KEY-----\n"

# Alternatively, set the path to your service account JSON key file:
# GOOGLE_APPLICATION_CREDENTIALS=credentials.json

# Google Drive folder containing your trust website images
# Make sure to share this folder with the Service Account Email address (Viewer permission)
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here
